# Copy to .env and fill in your values.
# For integration tests, set MAILEON_RUN_INTEGRATION=1 and MAILEON_API_KEY.

MAILEON_RUN_INTEGRATION=1
MAILEON_API_KEY=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
MAILEON_BASE_URI=https://api.maileon.com/1.0

# Test contact data — these contacts will be created, modified, and deleted.
MAILEON_TEST_EMAIL=php-api-test@example.com
MAILEON_TEST_EMAIL2=php-api-test-2@example.com
MAILEON_TEST_EXTERNAL_ID=php-api-ext-001
MAILEON_TEST_EXTERNAL_ID2=php-api-ext-002

# Pre-existing objects required for read-only and write tests.
# Set to 0 to skip tests that depend on them.
MAILEON_TEST_MAILING_ID=0
MAILEON_TEST_CF_ID=0
MAILEON_TEST_BLACKLIST_ID=0
MAILEON_TEST_DOI_MAILING_KEY=
MAILEON_TEST_DE_ID=0
MAILEON_TEST_TX_TYPE_ID=0
MAILEON_TEST_TX_ID=
MAILEON_TEST_WEBHOOK_ID=0
